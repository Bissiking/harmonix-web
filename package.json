{
  "name": "harmonix-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Harmonix V3 — client web pour Sonora (auth Kyros, écoute collaborative Rift)",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/proxy.js && node --check server/ws.js"
  },
  "dependencies": {
    "cookie": "^0.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  }
}
