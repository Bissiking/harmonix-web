# Backend Sonora existant. Cette URL n'est utilisée que par le proxy Vite.
SONORA_URL=http://localhost:6002

# Port du frontend (développement et aperçu local du build).
HARMONIX_WEB_PORT=5174

# L'authentification et les secrets Kyros se configurent uniquement dans Sonora.
# Dans Sonora, ajouter l'origine du frontend à CORS_ORIGINS.
# Le callback Kyros reste celui du backend Sonora, commun à tous les frontends.
