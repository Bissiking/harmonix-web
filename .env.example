# ── Harmonix V3 ──────────────────────────────────────────────
# Client web pour Sonora (médiathèque + streaming + Rifts).
# Le serveur Harmonix fait le SSO Kyros puis proxy vers Sonora.

# Port du serveur Harmonix (API + SPA en production)
HARMONIX_PORT=6003

# Port du serveur de dev web (Vite). Par défaut 5173 ; le change si ce port
# est déjà occupé (ex. par un autre projet Vite).
HARMONIX_WEB_PORT=5173

# URL publique de l'app (utilisée pour construire le redirect_uri du callback)
# En dev : l'URL de Vite (le navigateur passe par Vite).
HARMONIX_BASE_URL=http://localhost:5173

# Backend Sonora (médiathèque / streaming)
SONORA_URL=http://localhost:6002

# Secret utilisé pour signer le cookie de session (obligatoire en production)
HARMONIX_SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure (true derrière HTTPS)
HARMONIX_COOKIE_SECURE=false

# ── Application Kyros (créée dans /admin) ────────────────────
# Modes : sso recommandé.
HARMONIX_KYROS_AUTHORIZE_URL=https://kyros.example.fr/authorize
HARMONIX_KYROS_TOKEN_URL=https://kyros.example.fr/token
HARMONIX_KYROS_REVOKE_URL=https://kyros.example.fr/revoke
HARMONIX_KYROS_CLIENT_ID=cli_harmonix
HARMONIX_KYROS_CLIENT_SECRET=copy-from-kyros-admin
HARMONIX_KYROS_SCOPE=profile email
# Optionnel : audience / resource audience si ton Kyros les exige
HARMONIX_KYROS_AUDIENCE=
HARMONIX_KYROS_RESOURCE_AUDIENCE=
